{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thales-sblue/video-generator/schemas/asset-requirements-v1.schema.json",
  "title": "AssetRequirements v1",
  "description": "An explicit specification of the assets a ShotPlan needs, one entry per distinct asset (shots that reuse a source share an entry). Realises the future 'AssetPlan' candidate from AGENTS.md as a specification only: nothing is downloaded, and provenance becomes a contract when the engine acquires external assets automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "shot_plan_id",
    "script_id",
    "orientation",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "script_id": {
      "type": "string",
      "minLength": 1
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "type",
          "query",
          "duration_needed_seconds",
          "orientation",
          "purpose",
          "used_by"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "image",
              "video"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "duration_needed_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "orientation": {
            "enum": [
              "landscape",
              "portrait",
              "square"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "used_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^scene_[0-9]{2,}_shot_[0-9]{2,}$"
            }
          },
          "min_count": {
            "type": "integer",
            "minimum": 1
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "queries": {
            "description": "Ordered alternative search queries, best first. Empty means the single 'query' field is all there is.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visual_intent_class": {
            "description": "Semantic Visual Relevance v1: the visual intent class the resolver must rank and reject candidates against. Null means rank as before.",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "literal",
              "metaphorical",
              "emotional",
              "scientific",
              "evidence_or_archive",
              "everyday_human",
              "tension_or_suspense",
              null
            ]
          },
          "visual_role": {
            "description": "Semantic Visual Relevance v1: the editorial job the chosen picture has to do.",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "explain",
              "symbolize",
              "shock",
              "humanize",
              "contextualize",
              "build_tension",
              "support_claim",
              null
            ]
          },
          "emotion": {
            "description": "Semantic Visual Relevance v1: the beat's emotional colour, used to refuse a candidate whose mood contradicts the narration.",
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
