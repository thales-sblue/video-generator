{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thales-sblue/video-generator/schemas/render-manifest-v1.schema.json",
  "title": "RenderManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "plan_id",
    "brief_id",
    "workflow",
    "local_only",
    "editorial_review",
    "plan_sha256",
    "sources",
    "outputs",
    "tools",
    "technical_validation_valid",
    "technical_validation_issues"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "workflow": {"type": "string", "minLength": 1},
    "local_only": {"const": true},
    "editorial_review": {"const": "not_performed"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileFingerprint"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileFingerprint"}
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/toolRecord"}
    },
    "technical_validation_valid": {"type": "boolean"},
    "technical_validation_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"technical_validation_valid": {"const": true}}},
      "then": {"properties": {"technical_validation_issues": {"maxItems": 0}}},
      "else": {"properties": {"technical_validation_issues": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "fileFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "file_size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "toolRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
