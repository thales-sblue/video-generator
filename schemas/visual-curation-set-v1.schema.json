{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thales-sblue/video-generator/schemas/visual-curation-set-v1.schema.json",
  "title": "VisualCurationSet v1",
  "description": "Every visual decision of one cut, in screen order, with the candidates offered to the human reviewer. Produced before the render; consumed by the review sheet and by the visual lock.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_id", "project_id", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "set_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "video_title": {"type": "string"},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Derived counts, recomputed on load; never authoritative."
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence_id",
          "block_id",
          "shot_indexes",
          "start_seconds",
          "seconds",
          "needs_approval",
          "options"
        ],
        "properties": {
          "sequence_id": {"type": "string", "pattern": "^seq_[0-9]{2,}$"},
          "block_id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "shot_indexes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          },
          "start_seconds": {"type": "number", "minimum": 0},
          "seconds": {"type": "number", "exclusiveMinimum": 0},
          "needs_approval": {"type": "boolean"},
          "decision_reason": {
            "enum": [
              "external_asset",
              "stock_footage",
              "visual_metaphor",
              "graphic_composition",
              "frame_choice",
              "multiple_plausible_solutions"
            ]
          },
          "recommended_option_id": {"type": "string", "pattern": "^[A-Z]$"},
          "recommendation_reason": {"type": "string"},
          "narrative_terms": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "gate_rejections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate", "reasons"],
              "properties": {
                "candidate": {"type": "string"},
                "reasons": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "option_id",
                "material_kind",
                "visual_concept",
                "justification",
                "assets"
              ],
              "properties": {
                "option_id": {"type": "string", "pattern": "^[A-Z]$"},
                "material_kind": {
                  "enum": [
                    "project_material",
                    "project_diagram",
                    "motion_typography",
                    "graphic_composition",
                    "external_asset"
                  ]
                },
                "visual_concept": {"type": "string", "minLength": 1},
                "justification": {"type": "string", "minLength": 1},
                "preview": {"type": "string"},
                "query": {"type": ["string", "null"]},
                "origin": {"type": "string"},
                "assets": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "role"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "role": {"type": "string", "minLength": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "start_seconds": {"type": "number", "minimum": 0},
                      "seconds": {"type": "number", "exclusiveMinimum": 0},
                      "origin": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
